{
  "expo": {
    "name": "biz-z.",
    "slug": "business-plan-builder",
    "scheme": "businessplanbuilder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/biz-z-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rhianna.businessplanbuilder",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFF2B3",
        "foregroundImage": "./assets/android-biz-z-foreground.png",
        "monochromeImage": "./assets/android-biz-z-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "business-plan-builder-6769c.web.app",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/app-check",
      "./plugins/withShortNativePaths",
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc0fe29d-176d-4e38-8f68-ada68fa486ad"
      }
    }
  }
}
